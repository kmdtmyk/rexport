class <%= class_name %>Exporter < Rexport::Exporter

  def headers
    [
    <% column_names.each do |column_name| -%>
  '<%= column_name -%>',
    <% end -%>
]
  end

  def ids_to_a(ids)
    <%= class_name %>.find(ids).map do |<%= name %>|
      [
      <% column_names.map do |column_name| -%>
  <%= "#{name}.#{column_name}" -%>,
      <% end -%>
]
    end
  end

end
