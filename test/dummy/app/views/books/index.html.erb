<p style="color: green"><%= notice %></p>

<% content_for :title, "Books" %>

<h1>Books</h1>

<div id="books">
  <% @books.each do |book| %>
    <%= render book %>
    <p>
      <%= link_to "Show this book", book %>
    </p>
  <% end %>
</div>

<%= link_to "New book", new_book_path %>
<%= link_to "csv", url_for(request.query_parameters.merge(format: :csv)) %>
<%= link_to "xlsx", url_for(request.query_parameters.merge(format: :xlsx)) %>
